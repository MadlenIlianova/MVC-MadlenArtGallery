@model List<GalleryData.Models.Artwork>
@{
    ViewData["Title"] = "Manage Artworks";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Manage Artworks</h1>
        <div>
            <a asp-controller="Artworks" asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus"></i> Add New Artwork
            </a>
            <a asp-action="Dashboard" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to Dashboard
            </a>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Image</th>
                                <th>Title</th>
                                <th>Author</th>
                                <th>Price</th>
                                <th>Year</th>
                                <th>Style</th>
                                <th>Technique</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var artwork in Model)
                            {
                                <tr>
                                    <td>
                                        @if (!string.IsNullOrEmpty(artwork.ImageUrl))
                                        {
                                            <img src="@artwork.ImageUrl" alt="@artwork.Title"
                                                 class="img-thumbnail"
                                                 style="width: 60px; height: 60px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="bg-secondary text-white d-flex align-items-center justify-content-center"
                                                 style="width: 60px; height: 60px;">
                                                No Image
                                            </div>
                                        }
                                    </td>
                                    <td>@artwork.Title</td>
                                    <td>@artwork.Author?.Name</td>
                                    <td><strong>$@artwork.Price</strong></td>
                                    <td>@artwork.Year</td>
                                    <td>@artwork.Style</td>
                                    <td>@artwork.Technique</td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-controller="Artworks" asp-action="Edit" asp-route-id="@artwork.Id"
                                               class="btn btn-sm btn-warning">
                                                <i class="fas fa-edit"></i> Edit
                                            </a>
                                            <a asp-controller="Artworks" asp-action="Delete" asp-route-id="@artwork.Id"
                                               class="btn btn-sm btn-danger"
                                               onclick="return confirm('Are you sure you want to delete this artwork?')">
                                                <i class="fas fa-trash"></i> Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> No artworks found.
            <a asp-controller="Artworks" asp-action="Create">Add your first artwork</a>
        </div>
    }
</div>