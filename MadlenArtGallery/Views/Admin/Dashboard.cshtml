@model MadlenArtGallery.Models.DashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-5">
    <h1 class="mb-4">Admin Dashboard</h1>
    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="card text-white bg-primary h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">Total Artworks</h5>
                    <h2 class="display-4">@Model.TotalArtworks</h2>
                    <a asp-action="ManageArtworks" class="btn btn-light btn-sm mt-2">Manage</a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-success h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">Total Users</h5>
                    <h2 class="display-4">@Model.TotalUsers</h2>
                    <a asp-action="ManageUsers" class="btn btn-light btn-sm mt-2">Manage</a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-warning h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">Total Bids</h5>
                    <h2 class="display-4">@Model.TotalBids</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-info h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">Total Purchases</h5>
                    <h2 class="display-4">@Model.TotalPurchases</h2>
                </div>
            </div>
        </div>
    </div>
    <div class="card mb-4">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">Quick Actions</h5>
        </div>
        <div class="card-body">
            <a asp-controller="Artworks" asp-action="Create" class="btn btn-primary me-2">
                <i class="fas fa-plus"></i> Add New Artwork
            </a>
            <a asp-action="ManageArtworks" class="btn btn-secondary me-2">
                <i class="fas fa-palette"></i> Manage Artworks
            </a>
            <a asp-action="ManageUsers" class="btn btn-info me-2">
                <i class="fas fa-users"></i> Manage Users
            </a>
        </div>
    </div>
</div>