@model List<GalleryData.Models.Bid>
@{
    ViewData["Title"] = "All Bids - Admin";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="fas fa-gavel"></i> All Bids</h1>
        <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to Dashboard
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Artwork</th>
                                <th>Artist</th>
                                <th>Bidder</th>
                                <th>Bid Amount</th>
                                <th>Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var bid in Model)
                            {
                                <tr>
                                    <td>@bid.Artwork.Title</td>
                                    <td>@bid.Artwork.Author?.Name</td>
                                    <td>@bid.User?.Email</td>
                                    <td><strong>$@bid.Price</strong></td>
                                    <td>@bid.Date.ToString("MMM dd, yyyy HH:mm")</td>
                                    <td>
                                        <form asp-action="DeleteBid" asp-route-id="@bid.Id" method="post" style="display:inline;">
                                            <button type="submit" class="btn btn-sm btn-danger"
                                                    onclick="return confirm('Delete this bid?')">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> No bids have been placed yet.
        </div>
    }
</div>