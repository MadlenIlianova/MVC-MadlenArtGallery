@page
@model LoginModel
@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<link rel="stylesheet" href="~/css/auth-glass.css" />
<link rel="stylesheet" href="~/css/reset.css" />
<div class="auth-page">
    <div class="auth-glass">
        <h1>Madlen Art Gallery</h1>
        <p>Sign in to explore timeless art and exclusive collections.</p>

        <form method="post">
            <input asp-for="Input.Email" placeholder="Email" />
            <input asp-for="Input.Password" placeholder="Password" type="password" />

            <button type="submit">Login</button>
        
        <div class="mt-3 text-center">
                    <p class="text-muted">
                        Don't have an account?
                    </p>
                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="btn btn-outline-primary w-100">
                        <i class="fas fa-user-plus"></i> Create a new account
                    </a>
                </div>
            </form>
        
    </div>
</div>

<style>
    body {
        background: url('/images/gallery.png') center/cover no-repeat fixed !important;
        min-height: 100vh;
    }

    header, .footer, .navbar {
        display: none !important;
    }

    .main-content {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
    }
</style>

