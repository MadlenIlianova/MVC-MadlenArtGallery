            <div class="form-floating mb-3">
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>
            <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary">Register</button>
        </form>
    </div>
    <div class="col-md-6 col-md-offset-2">
        <section>
            <h3>Use another service to register.</h3>
            <hr />
            @{
                if ((Model.ExternalLogins?.Count ?? 0) == 0)
                {
                    <div>
                        <p>
                            There are no external authentication services configured. See this <a href="https://go.microsoft.com/fwlink/?LinkID=532715">article
                            about setting up this ASP.NET application to support logging in via external services</a>.
                        </p>
                    </div>
                }
                else
                {
                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="form-horizontal">
                        <div>
                            <p>
                                @foreach (var provider in Model.ExternalLogins!)
                                {
                                    <button type="submit" class="btn btn-primary" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">@provider.DisplayName</button>
                                }
                            </p>
                        </div>
                    </form>
                }
            }
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}  *@

@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
    Layout = null; 
}

<link rel="stylesheet" href="~/css/auth-glass.css" />
<link rel="stylesheet" href="~/css/reset.css" />
<div class="auth-page">
    <div class="auth-glass">
        <h1>Create Account</h1>
        <p>Join Madlen Art Gallery</p>

        <form method="post">
            <input asp-for="Input.Email" placeholder="Email" />
            <input asp-for="Input.Password" placeholder="Password" type="password" />
            <input asp-for="Input.ConfirmPassword" placeholder="Confirm Password" type="password" />
            <button type="submit">Register</button>
            <div class="mt-3 text-center">
                <hr style="border-color: rgba(255,255,255,0.3);" />
                <p style="color: rgba(255,255,255,0.7);">
                    Already have an account?
                </p>
                <a asp-page="./Login" class="btn btn-outline-light w-100">
                    <i class="fas fa-sign-in-alt"></i> Sign in
                </a>
            </div>
        </form>
    </div>
</div>

<style>
    body {
        background: url('/images/gallery.png') center/cover no-repeat fixed !important;
        min-height: 100vh;
    }

    header, .footer, .navbar {
        display: none !important;
    }

    .main-content {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
    }
</style>